# Required to start the backend. Do not commit a populated .env file.
NODE_ENV=
PORT=
CORS_ORIGINS=
DATABASE_URL=
JWT_SECRET=

# Required in production for password reset. PASSWORD_RESET_SECRET is an accepted legacy alternative.
JWT_RESET_SECRET=
PASSWORD_RESET_SECRET=

# Alternative database configuration when DATABASE_URL is not used. Set all five values together.
DB_USER=
DB_HOST=
DB_NAME=
DB_PASSWORD=
DB_PORT=

# Optional features. The related feature returns a controlled error or is disabled when unset.
RESEND_API_KEY=
PROXYCHECK_API_KEY=
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_PROJECT_ID=
GOOGLE_CLOUD_PROJECT=
GCLOUD_PROJECT=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
DISPOSABLE_EMAIL_DOMAINS=
ALLOWED_EMAIL_DOMAINS=
